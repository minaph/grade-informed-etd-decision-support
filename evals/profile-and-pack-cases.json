      ],
      "expected_concepts": [
        "Scientific or scholarly value",
        "Feasibility and capacity"
      ]
    },
    {
      "case_id": "academic_high_value_ethics_equity",
      "query": "学術価値は高いが、公平性と研究倫理に重大な懸念がある計画を評価して。",
      "assertions": [
        "no ethics approval is inferred",
        "stop or modify conditions are explicit"
