{
  "cases": [
    {
      "case_id": "academic_funding_priority",
      "query": "研究資金を三つの候補課題へ配分するため、監査可能な意思決定記録を作成してほしい。",
      "assertions": [
        "Select material concepts with reasons; do not demand an assessment of every candidate",
        "no formal GRADE label",
        "the basis for allocation can be traced to sources and judgments"
      ],
      "expected_domain_references": [
        "references/domain-academic.md"
      ],
      "expected_concepts": [
        "Scientific or scholarly value",
        "Methodological credibility",
        "Feasibility and capacity",
        "Distribution of benefits and burdens",
        "Dissemination and use"
      ]
    },
    {
      "case_id": "academic_staff_allocation",
      "query": "限られた研究人員を複数プロジェクトへ配分したい。学術価値、方法の信頼性、能力、公平性で比較して。",
      "assertions": [
        "resource allocation is conditional on capacity evidence"
      ],
      "expected_domain_references": [
        "references/domain-academic.md"
      ],
      "expected_concepts": [
        "Scientific or scholarly value",
        "Methodological credibility",
        "Feasibility and capacity",
        "Distribution of benefits and burdens"
      ]
    },
    {
      "case_id": "academic_transparency_assessment",
      "query": "研究計画の透明性と再現可能性を評価し、改善条件を示して。",
      "assertions": [
        "openness is bounded by law, ethics, and context"
      ],
      "expected_domain_references": [
        "references/domain-academic.md"
      ],
      "expected_concepts": [
        "Methodological credibility",
        "Transparency and reproducibility"
      ]
    },
    {
      "case_id": "academic_sharing_method",
      "query": "研究成果の公開・共有方法を選びたい。アクセス、再利用、倫理、利用可能性を比較して。",
      "assertions": [
        "human-subject rules are not generalized to all research"
      ],
      "expected_domain_references": [
        "references/domain-academic.md"
      ],
      "expected_concepts": [
        "Ethics and integrity",
        "Transparency and reproducibility",
        "Dissemination and use"
      ]
    },
    {
      "case_id": "academic_feasible_low_value",
      "query": "実行可能性は高いが学術価値が限定的な研究計画を採択すべきか。",
      "assertions": [
        "feasibility does not overwrite scholarly value"
